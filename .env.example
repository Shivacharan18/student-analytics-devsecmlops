# Student Analytics DevSecMLOps Configuration Template
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8501

# Data Paths
RAW_DATA_PATH=data/raw/student_performance_raw.csv
PROCESSED_DATA_PATH=data/processed/student_performance_clean.csv
MODEL_PATH=models/model.pkl

# Security & Validation
ENABLE_DATA_INTEGRITY_CHECK=true
MAX_MISSING_PERCENTAGE=10.0
MIN_RECALL_GATE=0.85
MIN_ACCURACY_GATE=0.80
MIN_ROCAUC_GATE=0.85

# Logging
LOG_LEVEL=INFO
